# Copy to .env and fill in. Every value below has a working development
# default, so the project runs without this file.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Frontend -------------------------------------------------------------
# Used for CORS and for building links inside emails.
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email ----------------------------------------------------------------
# Leave EMAIL_HOST_USER and EMAIL_HOST_PASSWORD blank to print emails to the
# console instead of sending them. Set both to send over real SMTP.
#
# For Gmail, EMAIL_HOST_PASSWORD must be a 16-character App Password created at
# https://myaccount.google.com/apppasswords (a normal account password is
# rejected). Two-step verification has to be on before app passwords appear.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@shelfsense.ai
